# Prettier writes LF (its default `endOfLine`), so the repository stores LF and
# checks out LF on every platform. Without this, Windows checkouts get CRLF and
# `npm run format:check` fails on files nobody edited.
* text=auto eol=lf

# Binary assets — never normalised, never diffed as text.
*.png binary
*.jpg binary
*.webp binary
*.avif binary
*.pdf binary
*.woff binary
*.woff2 binary
