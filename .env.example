# Palm Villa — environment template.
# Copy to `.env.local` and fill in. Never commit real values (architecture.md §10).

# ---------------------------------------------------------------------------
# Local development
#
# architecture.md §10 defines the local environment as the Supabase CLI stack:
# Postgres, Auth and Storage in Docker on your own machine. Start it with
#
#   npm run db:start     # prints the API URL and the three keys below
#   npm run db:reset     # applies every migration in supabase/migrations, then
#                        # supabase/seed.sql
#
# and copy the values it prints into `.env.local`. They are local-only and
# still do not belong in the repository.
#
# The integration tests read the same file, so `npm run test` needs the stack
# running — it fails with instructions rather than skipping, because a green
# run has to mean capability G1 was actually verified.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — hosted project at ap-southeast-1 (Singapore). One project per
# environment: a dev project for Vercel previews, a prod project for production.
# ---------------------------------------------------------------------------

# Project URL. Locally this is http://127.0.0.1:54321; hosted, it is
# https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Safe to expose to the browser: it carries no privilege
# beyond RLS, and RLS is enabled with no policies, so it can read nothing. Data
# access still happens server-side only (architecture.md §2).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only, bypasses RLS — never prefix with NEXT_PUBLIC_,
# never import into a client component. This is the key lib/supabase/data.ts
# uses for the query layer: authorisation is enforced in the server layer by
# requirePermission(), not by row filters (architecture.md §4), and RLS is
# defence in depth beneath it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# First-admin bootstrap — read only by `npm run db:bootstrap-admin`
# (scripts/bootstrap-admin.mjs), which creates the first Admin account. Every
# further staff account is created from the portal by that admin. The app
# itself never reads these three.
# ---------------------------------------------------------------------------

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Nightly document retention job (capability G4, architecture.md §8)
#
# The job runs at /api/cron/document-retention and deletes documents whose
# retention period has run out. That route sits outside the session gate --
# proxy.ts matches /portal and /field, and a scheduled caller has no cookies --
# so this secret is the whole of its authorisation.
#
# In production Vercel sends it automatically as `Authorization: Bearer <value>`
# for the cron declared in vercel.json; set the same value in the project's
# environment variables. Locally, generate one and call the route by hand:
#
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#     http://localhost:3000/api/cron/document-retention
#
# Any long random string. `openssl rand -hex 32` is one way.
# ---------------------------------------------------------------------------

CRON_SECRET=
