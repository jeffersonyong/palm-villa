# Palm Villa — environment template.
# Copy to `.env.local` and fill in. Never commit real values (architecture.md §10).

# ---------------------------------------------------------------------------
# Supabase — project at ap-southeast-1 (Singapore). One project per environment:
# a dev project for local + Vercel previews, a prod project for production.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key. Safe to expose to the browser: it carries no privilege
# beyond RLS. Data access still happens server-side only (architecture.md §2).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only, bypasses RLS — never prefix with NEXT_PUBLIC_,
# never import into a client component. Unused by the skeleton; listed so the
# deployment checklist is complete.
# SUPABASE_SERVICE_ROLE_KEY=
